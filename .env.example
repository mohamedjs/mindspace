# Client env — copy this file to .env and fill in real values.
# EXPO_PUBLIC_* vars are bundled into the app and visible to anyone who
# inspects it. Only the anon/publishable key belongs here, never a secret key.

# Supabase project settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Everything below this line is an EDGE FUNCTION secret, not a client var.
# Set these with `supabase secrets set` or Dashboard -> Edge Functions ->
# Secrets. They must never be prefixed EXPO_PUBLIC_ and never shipped in the
# app bundle or committed anywhere.
#
#   supabase secrets set PLATFORM_OPENROUTER_KEY=sk-or-v1-...
#   supabase secrets set BYOK_MASTER_KEY=$(openssl rand -base64 32)
#   supabase secrets set FX_EGP_PER_USD=50
#   supabase secrets set FX_BUFFER=1.15
#   supabase secrets set FREE_TIER_CREDITS=100
#   supabase secrets set FREE_MAX_RECORDING_SEC=180
#
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically into every Edge Function by the platform — do not set them.
# ---------------------------------------------------------------------------
