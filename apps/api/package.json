{
  "name": "@mindspace/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "start": "node dist/main.http.js",
    "worker": "node dist/main.worker.js",
    "migrate": "node dist/main.migrate.js",
    "dev": "tsx watch src/main.http.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.1",
    "@fastify/multipart": "10.1.8",
    "@fastify/rate-limit": "11.2.2",
    "@mindspace/contracts": "*",
    "bcrypt": "6.0.0",
    "fastify": "5.12.8",
    "ioredis": "6.0.0",
    "jose": "6.2.15",
    "kysely": "0.29.8",
    "node-pg-migrate": "9.0.0",
    "p-limit": "7.3.3",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^7.0.0",
    "vitest": "5.1.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.3.0"
  }
}
