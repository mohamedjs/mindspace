{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "es2022",
    // Not nodenext: the _shared files sit under the repo-root package.json,
    // which has no "type": "module", so nodenext would emit them as CJS into
    // this ESM package and the named imports would fail at runtime.
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    // The layout + extraction logic is imported straight from
    // supabase/functions/_shared, which lives above this package — hence the
    // repo-root rootDir (and the dist/apps/mcp/src/... bin path it implies).
    // rewriteRelativeImportExtensions turns those Deno-style ".ts" specifiers
    // into ".js" on emit.
    "rootDir": "../..",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "../../supabase/functions/_shared/layout.ts",
    "../../supabase/functions/_shared/extraction.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
