{
  "name": "mindspace-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:mobile": "npm run start --workspace=@mindspace/mobile",
    "dev:web": "npm run dev --workspace=@mindspace/web",
    "build:web": "npm run build --workspace=@mindspace/web",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
